        "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(iaas_http_requests_total[5m]))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Total requests (contador)",
        "datasource": { "type": "prometheus", "uid": "cfv4gr5ivplhcf" },
        "gridPos": { "h": 5, "w": 24, "x": 0, "y": 9 },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "targets": [
          {
            "expr": "sum(iaas_http_requests_total)",
