        "title": "Requests HTTP por endpoint (rate 5m)",
        "datasource": { "type": "prometheus", "uid": "cfv4gr5ivplhcf" },
        "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
